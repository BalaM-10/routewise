# Firebase web app config (Firebase console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check. For local development set VITE_APPCHECK_DEBUG=true, run the app,
# copy the debug token printed in the browser console and register it in
# Firebase console > App Check > Apps > Manage debug tokens. Never commit it.
VITE_APPCHECK_DEBUG=true
# reCAPTCHA Enterprise site key for the hosted demo
VITE_RECAPTCHA_SITE_KEY=
# Optional: a debug token you registered yourself. Leave empty to have one printed in the console.
VITE_APPCHECK_DEBUG_TOKEN=
